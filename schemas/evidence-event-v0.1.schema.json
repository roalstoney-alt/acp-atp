{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patl.example/schemas/evidence-event-v0.1.schema.json",
  "title": "PATL Evidence Event v0.1.1",
  "type": "object",
  "required": [
    "event_version",
    "event_type",
    "event_id",
    "request_id",
    "request_digest",
    "contract_id",
    "agent_stack",
    "agent_id",
    "action_type",
    "resource",
    "decision",
    "lifecycle_status",
    "lifecycle_transitions",
    "reasons",
    "violations",
    "policy_version",
    "created_at",
    "content_ref"
  ],
  "properties": {
    "event_version": {"const": "patl-evidence-v0.1.1"},
    "event_type": {"const": "patl.enforcement_decision"},
    "event_id": {"type": "string", "pattern": "^ev_"},
    "request_id": {"type": "string"},
    "request_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "contract_id": {"type": "string"},
    "agent_stack": {
      "type": "object",
      "required": ["agent_id", "agent_version", "model_id", "tool_ids", "delegated_by"],
      "properties": {
        "agent_id": {"type": "string"},
        "agent_version": {"type": "string"},
        "model_id": {"type": "string"},
        "tool_ids": {"type": "array", "items": {"type": "string"}},
        "delegated_by": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "agent_id": {"type": "string"},
    "action_type": {"type": "string"},
    "resource": {"type": "string"},
    "decision": {"enum": ["ALLOW", "ALLOW_WITH_LOG", "REQUIRE_CONFIRMATION", "BLOCK"]},
    "lifecycle_status": {
      "enum": ["PENDING", "AWAITING_CONFIRMATION", "AUTHORIZED", "EXECUTED", "CONSUMED", "BLOCKED", "EXPIRED", "REVOKED"]
    },
    "lifecycle_transitions": {
      "type": "array",
      "items": {
        "enum": ["PENDING", "AWAITING_CONFIRMATION", "AUTHORIZED", "EXECUTED", "CONSUMED", "BLOCKED", "EXPIRED", "REVOKED"]
      },
      "minItems": 1
    },
    "reasons": {"type": "array", "items": {"type": "string"}},
    "violations": {"type": "array", "items": {"type": "string"}},
    "policy_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "content_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
