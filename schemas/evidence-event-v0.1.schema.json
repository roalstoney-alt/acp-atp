{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patl.example/schemas/evidence-event-v0.1.schema.json",
  "title": "PATL Evidence Event v0.1",
  "type": "object",
  "required": ["event_version", "event_type", "event_id", "request_id", "contract_id", "agent_id", "action_type", "decision", "reasons", "violations", "policy_version", "created_at", "request_digest", "previous_event_hash", "event_hash"],
  "properties": {
    "event_version": {"const": "patl-evidence-v0.1"},
    "event_type": {"const": "patl.enforcement_decision"},
    "event_id": {"type": "string"},
    "request_id": {"type": "string"},
    "contract_id": {"type": "string"},
    "agent_id": {"type": "string"},
    "action_type": {"type": "string"},
    "resource": {"type": "string"},
    "decision": {"enum": ["ALLOW", "ALLOW_WITH_LOG", "REQUIRE_CONFIRMATION", "BLOCK"]},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "violations": {"type": "array", "items": {"type": "string"}},
    "policy_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "content_ref": {"type": ["string", "null"]},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
